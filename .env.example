# =====================================================================
# 7X Executive Connect - configuration (Python fallback)
# Copy this file to ".env" and fill it in.  NEVER commit the real .env.
# =====================================================================

# ---- Safety switches -------------------------------------------------
# TEST       = every message goes ONLY to TEST_PHONE_NUMBER (default, safe)
# PRODUCTION = messages go to real employees (also needs PRODUCTION_CONFIRM)
APP_MODE=TEST

# true = do everything except call WhatsApp (nothing sent, nothing marked as sent)
DRY_RUN=true

# Set to false to stop the automation immediately (emergency stop)
AUTOMATION_ENABLED=true

# Required ONLY for APP_MODE=PRODUCTION. Must be exactly:
# I_UNDERSTAND_REAL_EMPLOYEES_WILL_RECEIVE_MESSAGES
PRODUCTION_CONFIRM=

# Your own phone (international format) - receives ALL messages in TEST mode
TEST_PHONE_NUMBER=+9715XXXXXXXX

# ---- WhatsApp Business Platform (Cloud API) ---------------------------
# From Meta Business Suite > Settings > System users (permanent token)
WHATSAPP_ACCESS_TOKEN=
# From WhatsApp Manager > Phone numbers (the official 7X number's ID, not the number itself)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v23.0

# ---- Templates (must be APPROVED in WhatsApp Manager) -----------------
BIRTHDAY_TEMPLATE_EN=employee_birthday
ANNIVERSARY_TEMPLATE_EN=work_anniversary
TEMPLATE_LANGUAGE_EN=en
# Arabic is used only when this is true AND the employee's Language column = AR
ARABIC_TEMPLATES_ENABLED=false
BIRTHDAY_TEMPLATE_AR=employee_birthday_ar
ANNIVERSARY_TEMPLATE_AR=work_anniversary_ar
TEMPLATE_LANGUAGE_AR=ar
# number -> {{2}} = "5"   |   phrase -> {{2}} = "1 year" / "5 years"
ANNIVERSARY_YEARS_FORMAT=number

# ---- Spreadsheet -------------------------------------------------------
# Local path of the employee workbook (keep it inside employee_data/ - git-ignored)
SPREADSHEET_PATH=employee_data/7X_Employees.xlsx
# Informational: OneDrive/SharePoint file ID used by the Make.com scenario
SPREADSHEET_ID=

# ---- Logs & audit -------------------------------------------------------
EVENT_DB_PATH=data/event_log.db
AUDIT_CSV_PATH=logs/audit_log.csv
LOG_FILE_PATH=logs/automation.log

# ---- Timing -------------------------------------------------------------
TIMEZONE=Asia/Dubai
REQUEST_TIMEOUT_SECONDS=20
MAX_RETRIES=3
SEND_DELAY_SECONDS=1
