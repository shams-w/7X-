!sample_data/7X_Employees_SAMPLE.xlsx

# ---- Runtime output ----
logs/*
!logs/.gitkeep
data/*
!data/.gitkeep
STOP
*.lock
*.db
*.db-wal
*.db-shm

# ---- Python ----
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/
