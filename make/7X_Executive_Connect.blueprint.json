              },
              "mapper": {
                "drive": "ONEDRIVE_OR_SHAREPOINT_DRIVE_ID",
                "workbook": "SPREADSHEET_ID",
                "worksheet": "Employees",
                "rowNumber": "{{3.row_no}}",
                "values": {
                  "9": "{{if(1.APP_MODE = \"PRODUCTION\"; 1.THIS_YEAR; 3.anniversary_sent_year)}}",
                  "10": "Anniversary",
                  "11": "{{1.NOW_TEXT}}",
                  "12": "{{if(1.APP_MODE = \"PRODUCTION\"; \"SENT\"; \"TEST_SENT\")}}",
